@@ -670,6 +671,11 @@ def matplotlib_fname():
     """
 
     def gen_candidates():
+        # First check source tree location
+        src_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "mpl-data", "matplotlibrc.template")
